# Kopieren nach .env und anpassen. Wird NICHT eingecheckt.
PUBLIC_URL=https://quotes.example.com

# SSO mit authentik (alles auskommentieren = nur Passwort-Login)
OIDC_ISSUER=https://auth.example.com/application/o/quotes/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=authentik
# OIDC_ALLOW_SIGNUP=false
# OIDC_PASSWORD_LOGIN=false
