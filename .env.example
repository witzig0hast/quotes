# Kopieren nach .env und anpassen. Wird NICHT eingecheckt.
PUBLIC_URL=https://quotes.example.com

# SSO mit authentik (alles auskommentieren = nur Passwort-Login)
OIDC_ISSUER=https://auth.example.com/application/o/quotes/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=authentik
# OIDC_ALLOW_SIGNUP=false
# OIDC_PASSWORD_LOGIN=false

# Feste Admins (Benutzernamen, kommagetrennt)
# ADMIN_USERS=karim

# Push-Benachrichtigungen (Schlüssel erzeugen: npm run vapid)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# E-Mail (Bestätigung + Wochenrückblick); braucht zusätzlich PUBLIC_URL
# SMTP_URL=smtps://user:passwort@mail.example.com:465
# MAIL_FROM=Quotes <quotes@example.com>

# Wikipedia-Auszüge auf Personen-Seiten (Standard: an, Sprache de)
# WIKIPEDIA=off
# WIKIPEDIA_LANG=de
